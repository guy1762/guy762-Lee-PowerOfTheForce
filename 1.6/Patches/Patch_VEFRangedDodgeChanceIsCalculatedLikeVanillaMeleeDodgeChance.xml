<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  
	<Operation Class="PatchOperationFindMod" IfModActive="OskarPotocki.VanillaFactionsExpanded.Core">
		<mods>
			<li>Vanilla Expanded Framework</li>
		</mods>
		
		<match Class="PatchOperationAdd">
		  <xpath>Defs/StatDef[defName="VEF_RangedDodgeChance"]</xpath>
		  <order>Append</order>
		  <value>
				<skillNeedOffsets>
				  <li Class="SkillNeed_BaseBonus">
					<skill>Shooting</skill>
					<baseValue>0</baseValue>
					<bonusPerLevel>1</bonusPerLevel>
				  </li>
				</skillNeedOffsets>
				<capacityOffsets>
				  <li>
					<capacity>Moving</capacity>
					<scale>18</scale>
				  </li>
				  <li>
					<capacity>Sight</capacity>
					<scale>8</scale>
					<max>1.4</max>
				  </li>
				</capacityOffsets>
				<postProcessCurve>
				  <points>
					<li>(5, 0)</li>
					<li>(20, 0.30)</li>
					<li>(60, 0.50)</li>
				  </points>
				</postProcessCurve>
		  </value>
		</match>
	  
	</Operation>
	
