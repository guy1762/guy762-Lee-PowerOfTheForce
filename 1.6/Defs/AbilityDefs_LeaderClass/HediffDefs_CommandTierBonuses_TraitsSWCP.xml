	<HediffDef>
		<defName>guy762_hediff_CommandTierTraitBonusBuff_unyielding</defName>
		<label>Command bonus: Unyielding</label>
		<description>Combat stats are impacted by being near someone who is using a command tier ability who also has the "unyielding" trait.\n\nNOTE: blocks all mental breaks from low mood.</description>
		<debugLabelExtra>other</debugLabelExtra>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(255,255,7)</defaultLabelColor>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<showRemainingTime>false</showRemainingTime>
			</li>
			<li Class="HediffCompProperties_DisappearsOnDeath"/>
		</comps>
		<isBad>false</isBad>
		<stages>
			<li>
				<statOffsets>
					<MentalBreakThreshold>-0.27</MentalBreakThreshold>
				</statOffsets>
				<statFactors>
					<CertaintyLossFactor MayRequire="Ludeon.RimWorld.Ideology">0.125</CertaintyLossFactor>
					<SWCPStat_Loyalty>4</SWCPStat_Loyalty>
				</statFactors>
			</li>
		</stages>
		<modExtensions>
			<li Class="MentalBreakBlocker.ModExtension_MentalBreakBlocker">
				<!--choose one: mood, damage, psycast, moodAndDamage, moodAndPsycast, damageAndPsycast, all-->
				<!--  allow only mood or damage cause  -->
				<cause>mood</cause>
				<isWhitelist>true</isWhitelist>
			</li>
		</modExtensions>
	</HediffDef>
	
	
	
	
	
	
	
	
	
	
