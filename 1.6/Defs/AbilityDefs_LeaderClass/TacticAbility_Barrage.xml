<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	
	
	<AbilityDef ParentName="SWPotF_TacticDelegationAbilityBASE">
		<defName>SWPotF_TacticDelegationAbility_barrage</defName>
		<label>delegate tactic: Barrage</label>
		<description>Distribute temporary "Barrage" tactical orders to a subordinate.</description>
		<descriptionHyperlinks>
			<AbilityDef>SWPotF_TacticAbility_Barrage</AbilityDef>
		</descriptionHyperlinks>
		<iconPath>UI/EaWIcons/Delegation/Delegate_Barrage</iconPath>
		
		<comps>
			<li Class="CompProperties_AbilityGiveHediff">
				<compClass>CompAbilityEffect_GiveHediff</compClass>
				<hediffDef>SWPotF_DelegatedTacticHediff_barrage</hediffDef>
				<onlyApplyToSelf>false</onlyApplyToSelf>
				<onlyBrain>True</onlyBrain>
				<replaceExisting>true</replaceExisting>
				<applicableToMechs>False</applicableToMechs>
			</li>
		</comps>
	</AbilityDef>
	
	
	

	<HediffDef ParentName="SWPotF_DelegatedTacticHediffBASE">
		<defName>SWPotF_DelegatedTacticHediff_barrage</defName>
		<label>temporary tactical orders: Barrage</label>
		<description>.</description>
		<comps>
			<li Class="HediffCompProperties_GiveAbility">
				<abilityDef>SWPotF_TacticAbility_Barrage</abilityDef>
			</li>
		</comps>
	</HediffDef>














  
	<AbilityDef>
		<defName>SWPotF_TacticAbility_Barrage</defName>
		<label>Barrage</label>
		<description>Command your units armed with heavy ordnance weapons to fire rapidly. Aiming and cooldown times are reduced by 75%, but accuracy is reduced by 25%.</description>
		<iconPath>UI/EaWIcons/Barrage</iconPath>
		<warmupMoteSocialSymbol>UI/EaWIcons/Barrage</warmupMoteSocialSymbol>
		<uiOrder>762</uiOrder>
		<hotKey>Misc10</hotKey>
		
		<aiCanUse>true</aiCanUse>
		<ai_IsOffensive>false</ai_IsOffensive>
		<hostile>false</hostile>
		<casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
		<groupAbility>true</groupAbility>
		<ai_SearchAOEForTargets>true</ai_SearchAOEForTargets>
		<canUseAoeToGetTargets>true</canUseAoeToGetTargets>
		
		<cooldownTicksRange>12000</cooldownTicksRange>
		<targetRequired>false</targetRequired>
		<statBases>
			<Ability_Duration>15</Ability_Duration>
			<Ability_EffectRadius>10</Ability_EffectRadius>
		</statBases>
		<verbProperties>		
			<verbClass>Verb_CastAbility</verbClass>
			<violent>false</violent>
			<range>10</range>
			<requireLineOfSight>false</requireLineOfSight>
			<drawAimPie>False</drawAimPie>
			<warmupTime>0.5</warmupTime>
			<soundCast>kotorsound_CW2002PowerUp</soundCast>
			<targetParams>
				<canTargetSelf>true</canTargetSelf>
				<canTargetBuildings>false</canTargetBuildings>
				<canTargetItems>false</canTargetItems>
				
				<canTargetPawns>true</canTargetPawns>
				<canTargetAnimals>false</canTargetAnimals>
				<canTargetHumans>true</canTargetHumans>
				<canTargetMechs>false</canTargetMechs>
				
				<neverTargetIncapacitated>true</neverTargetIncapacitated>
				<!-- <neverTargetHostileFaction>true</neverTargetHostileFaction> don't use this, it checks for factions automatically -->
			</targetParams>
		</verbProperties>
		
		<comps>
			<li Class="CompProperties_AbilityGiveHediff">
				<compClass>CompAbilityEffect_GiveHediff</compClass>
				<hediffDef>SWPotF_TacticAbilityHediff_Barrage</hediffDef>
				<applicableToMechs>False</applicableToMechs>
				<!-- <onlyBrain>True</onlyBrain> -->
				<!-- <onlyApplyToSelf>False</onlyApplyToSelf> -->
				<replaceExisting>true</replaceExisting>
			</li>
			<li MayRequire="EBSG.Framework" Class="EBSGFramework.CompProperties_AbilityAbilityValidator">
				<targetStatLimiters>
					<SWCPStat_InfantryWeaponClass_heavyordnance>1</SWCPStat_InfantryWeaponClass_heavyordnance>
				</targetStatLimiters>
				
				<targetHasNoneOfHediffs>
					<li>SWPotF_TacticAbilityHediff_AmbushWaiting</li>
					<li>SWPotF_TacticAbilityHediff_AmbushAttacking</li>
					<li>SWPotF_TacticAbilityHediff_TakeCover</li>
					<li>SWPotF_TacticAbilityHediff_ZealousRage</li>
					<li>SWPotF_TacticAbilityHediff_Sprint</li>
					<li>SWPotF_TacticAbilityHediff_Harass</li>
				</targetHasNoneOfHediffs>
				
				<targetMentalStates />
				<targetMentalStateCheck>Forbidden</targetMentalStateCheck>
				
				<casterHasNoneOfHediffs>
					<li>SWPotF_TacticAbilityHediff_AmbushWaiting</li>
					<li>SWPotF_TacticAbilityHediff_AmbushAttacking</li>
					<li>SWPotF_TacticAbilityHediff_TakeCover</li>
					<li>SWPotF_TacticAbilityHediff_ZealousRage</li>
					<li>SWPotF_TacticAbilityHediff_Sprint</li>
					<li>SWPotF_TacticAbilityHediff_Harass</li>
				</casterHasNoneOfHediffs>
				<casterCapLimiters>
					<li>
						<capacity>Consciousness</capacity>
						<minCapValue>0.75</minCapValue>
					</li>
					<li>
						<capacity>Talking</capacity>
						<minCapValue>0.5</minCapValue>
					</li>
				</casterCapLimiters>
			</li>
		</comps>
	</AbilityDef>
	
	
	
	
	
	<HediffDef>
        <defName>SWPotF_TacticAbilityHediff_Barrage</defName>
        <label>Barrage strategy</label>
        <description>This pawn is firing rapidly.</description>
		<defaultLabelColor>(255,255,135)</defaultLabelColor> <!-- soft yellow -->
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>false</isBad>
        <stages>
            <li>
				<statFactors>
					<!-- <ShootingAccuracyPawn>0.75</ShootingAccuracyPawn> -->
					<ShootingAccuracyFactor_Touch>0.75</ShootingAccuracyFactor_Touch>
					<ShootingAccuracyFactor_Short>0.75</ShootingAccuracyFactor_Short>
					<ShootingAccuracyFactor_Medium>0.75</ShootingAccuracyFactor_Medium>
					<ShootingAccuracyFactor_Long>0.75</ShootingAccuracyFactor_Long>
					
					<RangedCooldownFactor>0.25</RangedCooldownFactor>
					<AimingDelayFactor>0.25</AimingDelayFactor>
				</statFactors>
			</li>
        </stages>
        <comps>
			<li Class="SWCP_Misc.HediffCompProperties_DisappearsOnDowned"/>
			<li Class="HediffCompProperties_DisappearsOnDeath"/>
            <li Class="HediffCompProperties_Disappears">
                <!-- <disappearsAfterTicks>60000</disappearsAfterTicks> -->
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
    </HediffDef>
	
	
	
	
	
	
	
	
  
  
    

</Defs>