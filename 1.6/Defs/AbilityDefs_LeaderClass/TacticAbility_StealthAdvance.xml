<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	
	
	<AbilityDef ParentName="SWPotF_TacticDelegationAbilityBASE">
		<defName>SWPotF_TacticDelegationAbility_stealthadvance</defName>
		<label>delegate tactic: Stealth Advance</label>
		<description>Distribute temporary "Stealth Advance" tactical orders to a subordinate.</description>
		<descriptionHyperlinks>
			<AbilityDef>SWPotF_TacticAbility_StealthAdvance</AbilityDef>
		</descriptionHyperlinks>
		<iconPath>UI/EaWIcons/Delegation/Delegate_Stealth</iconPath>
		
		<comps>
			<li Class="CompProperties_AbilityGiveHediff">
				<compClass>CompAbilityEffect_GiveHediff</compClass>
				<hediffDef>SWPotF_DelegatedTacticHediff_stealthadvance</hediffDef>
				<onlyApplyToSelf>false</onlyApplyToSelf>
				<onlyBrain>True</onlyBrain>
				<replaceExisting>true</replaceExisting>
				<applicableToMechs>False</applicableToMechs>
			</li>
		</comps>
	</AbilityDef>
	
	
	

	<HediffDef ParentName="SWPotF_DelegatedTacticHediffBASE">
		<defName>SWPotF_DelegatedTacticHediff_stealthadvance</defName>
		<label>temporary tactical orders: Stealth Advance</label>
		<description>.</description>
		<comps>
			<li Class="HediffCompProperties_GiveAbility">
				<abilityDef>SWPotF_TacticAbility_StealthAdvance</abilityDef>
			</li>
		</comps>
	</HediffDef>














  
	<AbilityDef>
		<defName>SWPotF_TacticAbility_StealthAdvance</defName>
		<label>Stealth Advance</label>
		<description>Command your units to move swiftly while they are in stealth mode.</description>
		<iconPath>UI/EaWIcons/Stealth</iconPath>
		<warmupMoteSocialSymbol>UI/EaWIcons/Stealth</warmupMoteSocialSymbol>
		<uiOrder>762</uiOrder>
		<hotKey>Misc10</hotKey>
		
		<aiCanUse>true</aiCanUse>
		<ai_IsOffensive>false</ai_IsOffensive>
		<hostile>false</hostile>
		<casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
		<groupAbility>true</groupAbility>
		<ai_SearchAOEForTargets>true</ai_SearchAOEForTargets>
		<canUseAoeToGetTargets>true</canUseAoeToGetTargets>
		
		<cooldownTicksRange>12000</cooldownTicksRange>
		<targetRequired>false</targetRequired>
		<statBases>
			<Ability_Duration>15</Ability_Duration>
			<Ability_EffectRadius>10</Ability_EffectRadius>
		</statBases>
		<verbProperties>		
			<verbClass>Verb_CastAbility</verbClass>
			<violent>false</violent>
			<range>10</range>
			<requireLineOfSight>false</requireLineOfSight>
			<drawAimPie>False</drawAimPie>
			<warmupTime>0.5</warmupTime>
			<soundCast>kotorsound_EaWCloak_on</soundCast>
			<targetParams>
				<canTargetSelf>true</canTargetSelf>
				<canTargetBuildings>false</canTargetBuildings>
				<canTargetItems>false</canTargetItems>
				
				<canTargetPawns>true</canTargetPawns>
				<canTargetAnimals>false</canTargetAnimals>
				<canTargetHumans>true</canTargetHumans>
				<canTargetMechs>false</canTargetMechs>
				
				<neverTargetIncapacitated>true</neverTargetIncapacitated>
				<!-- <neverTargetHostileFaction>true</neverTargetHostileFaction> don't use this, it checks for factions automatically -->
			</targetParams>
		</verbProperties>
		
		<comps>
			<li Class="CompProperties_AbilityGiveHediff">
				<compClass>CompAbilityEffect_GiveHediff</compClass>
				<hediffDef>SWPotF_TacticAbilityHediff_StealthAdvance</hediffDef>
				<applicableToMechs>False</applicableToMechs>
				<!-- <onlyBrain>True</onlyBrain> -->
				<!-- <onlyApplyToSelf>False</onlyApplyToSelf> -->
				<replaceExisting>true</replaceExisting>
			</li>
			<li MayRequire="EBSG.Framework" Class="EBSGFramework.CompProperties_AbilityAbilityValidator">
				<casterHasAnyOfHediffs>
					<li>SWCP_StealthMode</li>
				</casterHasAnyOfHediffs>
				<targetHasAnyOfHediffs>
					<li>SWCP_StealthMode</li>
				</targetHasAnyOfHediffs>
				
				<targetHasNoneOfHediffs>
					<li>SWPotF_TacticAbilityHediff_AmbushWaiting</li>
					<li>SWPotF_TacticAbilityHediff_AmbushAttacking</li>
					<li>SWPotF_TacticAbilityHediff_Barrage</li>
					<li>SWPotF_TacticAbilityHediff_Charge</li>
					<li>SWPotF_TacticAbilityHediff_TakeCover</li>
					<li>SWPotF_TacticAbilityHediff_ZealousRage</li>
					<li>SWPotF_TacticAbilityHediff_Sprint</li>
					<li>SWPotF_TacticAbilityHediff_Harass</li>
					<li>SWPotF_TacticAbilityHediff_StealthAdvance</li>
				</targetHasNoneOfHediffs>
				
				<targetMentalStates />
				<targetMentalStateCheck>Forbidden</targetMentalStateCheck>
				
				<casterHasNoneOfHediffs>
					<li>SWPotF_TacticAbilityHediff_AmbushWaiting</li>
					<li>SWPotF_TacticAbilityHediff_AmbushAttacking</li>
					<li>SWPotF_TacticAbilityHediff_Barrage</li>
					<li>SWPotF_TacticAbilityHediff_Charge</li>
					<li>SWPotF_TacticAbilityHediff_TakeCover</li>
					<li>SWPotF_TacticAbilityHediff_ZealousRage</li>
					<li>SWPotF_TacticAbilityHediff_Sprint</li>
					<li>SWPotF_TacticAbilityHediff_Harass</li>
					<li>SWPotF_TacticAbilityHediff_StealthAdvance</li>
				</casterHasNoneOfHediffs>
				<casterCapLimiters>
					<li>
						<capacity>Consciousness</capacity>
						<minCapValue>0.75</minCapValue>
					</li>
					<li>
						<capacity>Talking</capacity>
						<minCapValue>0.5</minCapValue>
					</li>
				</casterCapLimiters>
			</li>
		</comps>
	</AbilityDef>
	
	
	
	
	
	<HediffDef>
        <defName>SWPotF_TacticAbilityHediff_StealthAdvance</defName>
        <label>Stealth Advance strategy</label>
        <description>This pawn is moving swiftly while in stealth mode.</description>
		<defaultLabelColor>(255,255,135)</defaultLabelColor> <!-- soft yellow -->
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>false</isBad>
        <stages>
            <li>
				<!-- <becomeVisible>false</becomeVisible> -->
				<statFactors>
					<MoveSpeed>2</MoveSpeed>
				</statFactors>
			</li>
        </stages>
        <comps>
			<li Class="SWCP_Misc.HediffCompProperties_DisappearsOnDowned"/>
			<li Class="HediffCompProperties_DisappearsOnDeath"/>
            <li Class="HediffCompProperties_Disappears">
                <!-- <disappearsAfterTicks>60000</disappearsAfterTicks> -->
                <showRemainingTime>true</showRemainingTime>
            </li>
        </comps>
    </HediffDef>
	
	
	
	
	
	
	
	
  
  
    

</Defs>