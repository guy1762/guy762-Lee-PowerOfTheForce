	<HediffDef>
		<defName>guy762_hediff_CommandTierCasterTraitBonus_carefulshooter</defName>
		<label>Command bonus: Careful Shooter (caster)</label>
		<description>By encouraging and commanding nearby allies, this person can enhance their focus in combat and thus their battle performance.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(255,255,7)</defaultLabelColor>
		<comps>
			<!-- <li Class="HediffCompProperties_Disappears"> -->
				<!-- <showRemainingTime>True</showRemainingTime> -->
			<!-- </li> -->
			<li Class="HediffCompProperties_DisappearsOnDeath"/>
			<li Class="HediffCompProperties_GiveHediffsInRange">
				<range>500</range>
				<hideMoteWhenNotDrafted>true</hideMoteWhenNotDrafted>
				<targetingParameters>
					<canTargetBuildings>false</canTargetBuildings>
					<canTargetAnimals>false</canTargetAnimals>
					<canTargetMechs>false</canTargetMechs>
				</targetingParameters>
				<hediff>guy762_hediff_CommandTierTraitBonusBuff_carefulshooter</hediff>
			</li>
		</comps>
		<isBad>false</isBad>
	</HediffDef>
	
	<HediffDef>
		<defName>guy762_hediff_CommandTierTraitBonusBuff_carefulshooter</defName>
		<label>Command bonus: Careful Shooter</label>
		<description>Combat stats are impacted by being near someone who is using a command tier ability who also has the "careful shooter" trait.</description>
		<debugLabelExtra>other</debugLabelExtra>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(255,255,7)</defaultLabelColor>
		<comps>
			<li Class="HediffCompProperties_Disappears">
				<showRemainingTime>false</showRemainingTime>
			</li>
			<li Class="HediffCompProperties_DisappearsOnDeath"/>
		</comps>
		<isBad>false</isBad>
		<stages>
			<li>
				<statOffsets>
					<AimingDelayFactor>1.25</AimingDelayFactor>
					<ShootingAccuracyPawn>5</ShootingAccuracyPawn>
				</statOffsets>
			</li>
		</stages>
	</HediffDef>
	
	
	
	
