<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<AbilityDef Name="SWPotFAbility_Feat_intimidate">
		<defName>SWPotFAbility_Feat_intimidate</defName>
		<label>intimidation</label>
		<description>Utilize this pawn's ferocious martial prowess to attempt to scare a target into fleeing. This rolls a check of the caster's Intimidation Power stat contested by the target's Willpower stat.\n\nPawns with the Iron-Willed, Unyielding, or Heroic traits are immune to this ability.</description>
		<descriptionHyperlinks>
			<HediffDef>SWPotFHediff_Feat_intimidated</HediffDef>
		</descriptionHyperlinks>
		<iconPath>UI/FeatIcons/PotF_Feat_Intimidate</iconPath>
		
		<!-- <category>SWPotF_AbilityCategory_Universal</category> -->
		<!-- <hotKey></hotKey> -->
		<writeCombatLog>True</writeCombatLog>
		
		<!-- <level>1</level> -->
		<aiCanUse>true</aiCanUse>
		<ai_IsOffensive>false</ai_IsOffensive>
		<hostile>false</hostile>
		<casterMustBeCapableOfViolence>false</casterMustBeCapableOfViolence>
		
		
		<cooldownTicksRange>12000</cooldownTicksRange>
		<stunTargetWhileCasting>true</stunTargetWhileCasting>
		<statBases>
			<!-- this is in seconds, not ticks -->
			<Ability_Duration>60</Ability_Duration>
		</statBases>
		
		<targetRequired>true</targetRequired>
		<verbProperties>		
			<verbClass>Verb_CastAbility</verbClass>
			<violent>false</violent>
			<drawAimPie>False</drawAimPie>
			<range>7</range>
			<requireLineOfSight>true</requireLineOfSight>
			<warmupTime>0.5</warmupTime>
			<soundCast>kotorsound_vader</soundCast>
			<targetParams>
				<canTargetSelf>false</canTargetSelf>
				<canTargetBuildings>false</canTargetBuildings>
				<canTargetItems>false</canTargetItems>
				
				<canTargetLocations>false</canTargetLocations>
				<canTargetPawns>true</canTargetPawns>
				<canTargetAnimals>true</canTargetAnimals>
				<canTargetHumans>true</canTargetHumans>
				<canTargetMechs>false</canTargetMechs>
				<neverTargetIncapacitated>true</neverTargetIncapacitated>
				<!-- <neverTargetHostileFaction>true</neverTargetHostileFaction> don't use this, it checks for factions automatically -->
			</targetParams>
		</verbProperties>
		
		<comps>
			<li Class="EBSGFramework.CompProperties_AbilityChangeFaction">
				<canTargetBosses>false</canTargetBosses>
				<useStatic>True</useStatic>
                <staticFaction>guy762_KotORFaction_Civilians</staticFaction>
				<successChance>
					<baseSuccessChance>0.5</baseSuccessChance> <!-- this is basically the DC -->
					
					<casterStatChance>SWCPStat_IntimidationPower</casterStatChance>
					<casterStatEffect>Multiply</casterStatEffect> <!-- success chance increases if stat is above 1 -->
					
					<targetStatChance>SWCPStat_Willpower</targetStatChance>
					<targetStatEffect>Divide</targetStatEffect> <!-- success chance decreases if stat is above 1 -->
					
					<successMessage>Intimidation attempt SUCCESS! {0} -> {1}</successMessage>
					<failureMessage>Intimidation attempt FAILED! {0} -> {1}</failureMessage>
				</successChance>
            </li>
			<li Class="CompProperties_AbilityGiveHediff">
				<compClass>CompAbilityEffect_GiveHediff</compClass>
				<hediffDef>SWPotFHediff_Feat_intimidated</hediffDef>
				<applyToTarget>true</applyToTarget>
				<!--replaceExisting>false</replaceExisting-->
				<applicableToMechs>False</applicableToMechs>
			</li>
			
			<li MayRequire="EBSG.Framework" Class="EBSGFramework.CompProperties_AbilityAbilityValidator">
				<targetGroup>Hostiles</targetGroup>
				
				<targetHasNoneOfTraits>
					<SWPotF_Trait_heroic />
					<SWCPTrait_Unyielding />
					<Nerves>2</Nerves>
				</targetHasNoneOfTraits>

				<targetMentalStates />
				<targetMentalStateCheck>Forbidden</targetMentalStateCheck>
			</li>
		</comps>
	</AbilityDef>
	
	
	
