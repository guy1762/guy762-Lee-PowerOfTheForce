	<HediffDef>
		<defName>SWPotFHediff_Feat_intimidated</defName>
		<label>Intimidated</label>
		<description>This pawn has been intimidated by an ability cast.</description>
		
		<defaultLabelColor>(255,7,48)</defaultLabelColor> <!-- red -->
		<hediffClass>HediffWithComps</hediffClass>
		<maxSeverity>1.0</maxSeverity>
		<isBad>true</isBad>
		<stages>
			<li>
				<statOffsets>
					<PainShockThreshold>-0.2</PainShockThreshold>
					<MentalBreakThreshold>0.2</MentalBreakThreshold>
					<Terror MayRequire="Ludeon.RimWorld.Ideology">0.5</Terror>
				</statOffsets>
			</li>
		</stages>
		<comps>
		  <!--2,500 ticks per hour in game-->
		  <li Class="HediffCompProperties_Disappears">
			<!--disappearsAfterTicks>1000</disappearsAfterTicks-->
			<showRemainingTime>True</showRemainingTime>
		  </li>
		  <li Class="HediffCompProperties_DisappearsOnDeath"/>
		  <li Class="HediffCompProperties_RemoveIfOtherHediff">
			<hediffs>
				<li>SWPotF_hediff_BatlMed_Buff</li>
				<li>SWPotF_hediff_AdvBatlMed_Buff</li>
				<li>SWPotF_hediff_MstBatlMed_Buff</li>
				
				<li>SWPotF_hediff_ForceValor</li>
				<li>SWPotF_hediff_KnightValor</li>
				<li>SWPotF_hediff_MstValor</li>
				
				<li>SWPotF_hediff_Enlightenment</li>
			</hediffs>
		  </li>
		</comps>
	</HediffDef>
	  
	<ThoughtDef>
		<defName>guy762_ThoughtDef_Intimidated</defName>
		<workerClass>ThoughtWorker_Hediff</workerClass>
		<hediff>SWPotFHediff_Feat_intimidated</hediff>
		<validWhileDespawned>false</validWhileDespawned>
		<developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
		<stages>
		  <li>
			<label>intimidated</label>
			<description>I gotta get out of here!</description>
			<baseMoodEffect>-50</baseMoodEffect>
		  </li>
		</stages>
		<lerpMoodToZero>true</lerpMoodToZero>
		<stackLimit>5</stackLimit>
	</ThoughtDef>

</Defs>