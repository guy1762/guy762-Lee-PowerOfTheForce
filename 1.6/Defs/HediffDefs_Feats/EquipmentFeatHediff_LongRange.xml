<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<HediffDef ParentName="SWPotFHediff_FeatBASE">
		<defName>SWPotFHediff_EquipmentFeat_longrangeI</defName>
		<label>Weapon Focus: Long-Ranged</label>
		<description>This pawn is adept in the use of all long-ranged guns, granting them an accuracy bonus at all ranges.</description>
		<initialSeverity>1</initialSeverity>
		
		<comps>
			<li MayRequire="EBSG.Framework" Class="EBSGFramework.HediffCompProperties_SeverityByEquipped">
                <severity>2</severity>
                <check>FirstOfEach</check>
				<equipmentTags>
					<!-- <li><text>SWCPWeaponClassTag_ShortRange</text></li> -->
					<li><text>SWCPWeaponClassTag_LongRange</text></li>
					<!-- <li><text>SWCPWeaponClassTag_HeavyOrdnance</text></li> -->
					<!-- <li><text>SWCPWeaponClassTag_Melee</text></li> -->
					<!-- <li><text>SWCPWeaponClassTag_Lightsaber</text></li> -->
				</equipmentTags>
            </li>
			<li MayRequire="EBSG.Framework" Class="EBSGFramework.HediffCompProperties_InvisibleAtStage">
                <invisibleStages><li>2</li></invisibleStages>
            </li>
        </comps>
		<stages>
			<li>
				<label>Active</label>
				<minSeverity>1</minSeverity>
				<becomeVisible>true</becomeVisible>
				
				<statFactors>
					<ShootingAccuracyFactor_Touch>1.1</ShootingAccuracyFactor_Touch>
					<ShootingAccuracyFactor_Short>1.1</ShootingAccuracyFactor_Short>
					<ShootingAccuracyFactor_Medium>1.1</ShootingAccuracyFactor_Medium>
					<ShootingAccuracyFactor_Long>1.1</ShootingAccuracyFactor_Long>
				</statFactors>
			</li>
			<li>
				<label>Inactive</label>
				<minSeverity>2</minSeverity> <!-- this has to go backwards for some reason -->
				<becomeVisible>false</becomeVisible>
			</li>
		</stages>
	</HediffDef>
	
	
