<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<HediffDef ParentName="SWPotFHediff_FeatBASE">
		<defName>SWPotFHediff_EquipmentFeat_lightarmor</defName>
		<label>Armor Focus: Light Infantry</label>
		<description>This pawn is adept in the use of all light armor, granting them greatly increased dodge chance.</description>
		<initialSeverity>1</initialSeverity>
		
		<comps>
			<li MayRequire="EBSG.Framework" Class="EBSGFramework.HediffCompProperties_SeverityByEquipped">
                <severity>2</severity>
                <check>FirstOfEach</check>
				<apparelTags>
					<li><text>SWCPArmorClassTag_LightInfantry</text></li>
					<!-- <li><text>SWCPArmorClassTag_MediumInfantry</text></li> -->
					<!-- <li><text>SWCPArmorClassTag_HeavyInfantry</text></li> -->
				</apparelTags>
            </li>
			<li MayRequire="EBSG.Framework" Class="EBSGFramework.HediffCompProperties_InvisibleAtStage">
                <invisibleStages><li>2</li></invisibleStages>
            </li>
        </comps>
		<stages>
			<li>
				<label>Active</label>
				<minSeverity>1</minSeverity>
				<becomeVisible>true</becomeVisible>
				
				<statFactors>
					<MeleeDodgeChance>1.3</MeleeDodgeChance>
					<VEF_RangedDodgeChance MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">1.3</VEF_RangedDodgeChance>
				</statFactors>
			</li>
			<li>
				<label>Inactive</label>
				<minSeverity>2</minSeverity> <!-- this has to go backwards for some reason -->
				<becomeVisible>false</becomeVisible>
			</li>
		</stages>
	</HediffDef>
	
	
	<HediffDef ParentName="SWPotFHediff_FeatBASE">
