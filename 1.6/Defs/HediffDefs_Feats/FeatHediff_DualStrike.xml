<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<HediffDef ParentName="SWPotFHediff_FeatBASE">
		<defName>SWPotFHediff_Feat_dualstrikeI</defName>
		<label>Feat: Dual Strike</label>
		<description>This pawn is trained to utilize teamwork while attacking enemies, giving them a bonus to shooting and melee accuracy when other colonists are within one tile of them while drafted.</description>

        <stages>
            <li><minSeverity>0</minSeverity><becomeVisible>false</becomeVisible></li>
        </stages>
        <comps>
			<li MayRequire="EBSG.Framework" Class="EBSGFramework.HediffCompProperties_HediffsWhileDrafted">
                <draftedHediffs>
                    <li><hediff>SWPotFHediff_Feat_dualstrikeI_draftedAoE</hediff></li>
                </draftedHediffs>
            </li>
        </comps>
    </HediffDef>
	
	<HediffDef>
        <defName>SWPotFHediff_Feat_dualstrikeI_draftedAoE</defName>
        <label>Dual Strike Passive Bonus</label>
        <description>This pawn is trained to utilize teamwork while attacking enemies, giving them a bonus to shooting and melee accuracy when other colonists are within one tile of them while drafted.</description>
        <hediffClass>HediffWithComps</hediffClass>
        <isBad>false</isBad>
        <stages>
            <li><minSeverity>0</minSeverity><becomeVisible>false</becomeVisible></li>
			<li>
				<minSeverity>1</minSeverity>
				<becomeVisible>true</becomeVisible>
				<statOffsets>
					<ShootingAccuracyFactor_Touch>0.2</ShootingAccuracyFactor_Touch>
					<ShootingAccuracyFactor_Short>0.2</ShootingAccuracyFactor_Short>
					<ShootingAccuracyFactor_Medium>0.2</ShootingAccuracyFactor_Medium>
					<ShootingAccuracyFactor_Long>0.2</ShootingAccuracyFactor_Long>
					<MeleeHitChance>0.2</MeleeHitChance>
				</statOffsets>
			</li>
        </stages>
        <comps>
			<li MayRequire="EBSG.Framework" Class="EBSGFramework.HediffCompProperties_SeverityByNearbyPawns">
                <range>1.9</range>
				<onlySameFaction>True</onlySameFaction>
                <onlyHumanlikes>True</onlyHumanlikes>
                <includeSelf>False</includeSelf>
            </li>
        </comps>
    </HediffDef>
	
	
	
	
	
	
	
	
