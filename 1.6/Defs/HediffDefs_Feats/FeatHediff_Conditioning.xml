<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<HediffDef ParentName="SWPotFHediff_FeatBASE">
		<defName>SWPotFHediff_Feat_conditioning</defName>
		<label>Feat: Conditioning</label>
		<description>This pawn is adapted to working in harsh conditions. They are better able to withstand environmental extremes, cope with stress, and survive longer without adequate food or rest.</description>

		<stages>
			<li>
				<!-- <label>active</label> -->
				<minSeverity>1</minSeverity>
				<becomeVisible>false</becomeVisible>
				
				<hungerRateFactorOffset>-0.1</hungerRateFactorOffset>
				<restFallFactorOffset>-0.1</restFallFactorOffset>
				<statOffsets>
					<JoyFallRateFactor>-0.1</JoyFallRateFactor>
					<MentalBreakThreshold>-0.1</MentalBreakThreshold>
					
					<SWCPStat_Willpower>0.1</SWCPStat_Willpower>
					
					<ToxicEnvironmentResistance>0.1</ToxicEnvironmentResistance>
					<ComfyTemperatureMin>-5</ComfyTemperatureMin>
					<ComfyTemperatureMax>-5</ComfyTemperatureMax>
				</statOffsets>
			</li>
			<li>
				<label>Improved</label>
				<minSeverity>2</minSeverity>
				<becomeVisible>false</becomeVisible>
				
				<hungerRateFactorOffset>-0.2</hungerRateFactorOffset>
				<restFallFactorOffset>-0.2</restFallFactorOffset>
				<statOffsets>
					<JoyFallRateFactor>-0.2</JoyFallRateFactor>
					<MentalBreakThreshold>-0.2</MentalBreakThreshold>
					
					<SWCPStat_Willpower>0.2</SWCPStat_Willpower>
					
					<ToxicEnvironmentResistance>0.2</ToxicEnvironmentResistance>
					<ComfyTemperatureMin>-10</ComfyTemperatureMin>
					<ComfyTemperatureMax>-10</ComfyTemperatureMax>
				</statOffsets>
			</li>
			<li>
				<label>Master</label>
				<minSeverity>3</minSeverity>
				<becomeVisible>false</becomeVisible>
				
				<hungerRateFactorOffset>-0.3</hungerRateFactorOffset>
				<restFallFactorOffset>-0.3</restFallFactorOffset>
				<statOffsets>
					<JoyFallRateFactor>-0.3</JoyFallRateFactor>
					<MentalBreakThreshold>-0.3</MentalBreakThreshold>
					
					<SWCPStat_Willpower>0.3</SWCPStat_Willpower>
					
					<ToxicEnvironmentResistance>0.3</ToxicEnvironmentResistance>
					<ComfyTemperatureMin>-15</ComfyTemperatureMin>
					<ComfyTemperatureMax>-15</ComfyTemperatureMax>
				</statOffsets>
			</li>
		</stages>
	</HediffDef>
	
</Defs>
