	<!-- Humanophobic_multiple_xenotypes: negative opinion of multiple specific xenotypes. -->
	<ThoughtDef>
		<defName>SWCPThought_RobophobicReaction</defName>
		<thoughtClass>Thought_SituationalSocial</thoughtClass>
		<workerClass>SWCP_FlyingSloth_Misc.ThoughtWorker_XenotypeReaction</workerClass>
		<modExtensions>
			<li Class="SWCP_FlyingSloth_Misc.ThoughtExtension_XenotypeReaction">
				<mode>SpecificXenotype</mode>
				<requiredTrait>SWCPTrait_DroidAttitude</requiredTrait>
				<requiredTraitDegree>-1</requiredTraitDegree>
				<targetXenotypes>
					<li>SWCPDroidXenotype_21BMedDroid</li>
					<li>SWCPDroidXenotype_3POProtocolDroid</li>
					<li>SWCPDroidXenotype_ASP7LaborDroid</li>
					<li>SWCPDroidXenotype_CLLM2BinaryLoadlifter</li>
					<li>SWCPDroidXenotype_LOMProtocolDroid</li>
					<li>SWCPDroidXenotype_PitDroid</li>
					<li>SWCPDroidXenotype_R2Series</li>
					<li>SWCPDroidXenotype_R4Series</li>
					<li>SWCPDroidXenotype_R5Series</li>
					<li>SWCPDroidXenotype_RA7ProtocolDroid</li>
				</targetXenotypes>
			</li>
		</modExtensions>
		<stages>
		  <li>
			<label>unwanted droid presence</label>
			<baseOpinionOffset>-18</baseOpinionOffset>
		  </li>
		</stages>
	</ThoughtDef>
	
	
	

	<ThoughtDef>
		<defName>SWCPThought_RobophileReaction</defName>
		<thoughtClass>Thought_SituationalSocial</thoughtClass>
		<workerClass>SWCP_FlyingSloth_Misc.ThoughtWorker_XenotypeReaction</workerClass>
		<modExtensions>
			<li Class="SWCP_FlyingSloth_Misc.ThoughtExtension_XenotypeReaction">
				<mode>SpecificXenotype</mode>
				<requiredTrait>SWCPTrait_DroidAttitude</requiredTrait>
				<requiredTraitDegree>1</requiredTraitDegree>
				<targetXenotypes>
					<li>SWCPDroidXenotype_21BMedDroid</li>
					<li>SWCPDroidXenotype_3POProtocolDroid</li>
					<li>SWCPDroidXenotype_ASP7LaborDroid</li>
					<li>SWCPDroidXenotype_CLLM2BinaryLoadlifter</li>
					<li>SWCPDroidXenotype_LOMProtocolDroid</li>
					<li>SWCPDroidXenotype_PitDroid</li>
					<li>SWCPDroidXenotype_R2Series</li>
					<li>SWCPDroidXenotype_R4Series</li>
					<li>SWCPDroidXenotype_R5Series</li>
					<li>SWCPDroidXenotype_RA7ProtocolDroid</li>
				</targetXenotypes>
			</li>
		</modExtensions>
		<stages>
		  <li>
			<label>droid presence</label>
			<baseOpinionOffset>15</baseOpinionOffset>
		  </li>
		</stages>
	</ThoughtDef>
	
	
	

</Defs>
