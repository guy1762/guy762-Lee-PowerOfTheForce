<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!--__________ Traits __________-->

    <!-- Art Lover -->

    <TraitDef>
        <defName>SWCPTrait_ArtLover</defName>
        <commonality>0.1</commonality>
        <degreeDatas>
            <li>
                <label>art lover</label>
                <description>[PAWN_nameDef] has a deep appreciation for visual art. Taking time to admire a piece of art lifts [PAWN_possessive] spirits, and sometimes sparks a burst of creative inspiration.</description>
				<statOffsets>
					<SWCPStat_TraitRatings_SumOfGoodBad>1</SWCPStat_TraitRatings_SumOfGoodBad>
					<SWCPStat_TraitRatings_Good>1</SWCPStat_TraitRatings_Good>
				</statOffsets>
            </li>
        </degreeDatas>
        <modExtensions>
            <li Class="SWCP.TraitExtension_ViewArtBonus">
                <thought>SWCPThought_ArtLoverViewed</thought>
                <inspiration>Inspired_Creativity</inspiration>
                <inspirationChance>0.05</inspirationChance>
            </li>
        </modExtensions>
    </TraitDef>
	<ThoughtDef>
        <defName>SWCPThought_ArtLoverViewed</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>0.5</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>artistic appreciation</label>
                <description>I took some time to appreciate a piece of art. It's still with me.</description>
                <baseMoodEffect>8</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>









    <!-- Unyielding -->

    <TraitDef>
        <defName>SWCPTrait_Unyielding</defName>
        <commonality>0.1</commonality>
        <degreeDatas>
            <li>
                <label>unyielding</label>
                <description>[PAWN_nameDef] has an unshakeable resolve. No amount of stress or danger will cause [PAWN_objective] to flee in panic or abandon [PAWN_possessive] colony.</description>
                <disallowedMentalStates>
                    <li>GiveUpExit</li>
                    <li>PanicFlee</li>
                    <li>PanicFleeFire</li>
                </disallowedMentalStates>
				
				<statOffsets>
					<MentalBreakThreshold>-0.27</MentalBreakThreshold>
					
					<SWCPStat_TraitRatings_SumOfGoodBad>1</SWCPStat_TraitRatings_SumOfGoodBad>
					<SWCPStat_TraitRatings_Good>1</SWCPStat_TraitRatings_Good>
					<SWCPStat_TraitRatings_LightSideAffinity>0.1</SWCPStat_TraitRatings_LightSideAffinity>
				</statOffsets>
				<statFactors>
					<CertaintyLossFactor MayRequire="Ludeon.RimWorld.Ideology">0.125</CertaintyLossFactor>
					<SWCPStat_Loyalty>4</SWCPStat_Loyalty>
					<SWCPStat_Willpower>2</SWCPStat_Willpower>
				</statFactors>
            </li>
        </degreeDatas>
        <conflictingTraits>
            <li>Nerves</li>
            <li>SWCPTrait_Loyal</li>
            <li>SWCPTrait_Cowardly</li>
        </conflictingTraits>
    </TraitDef>








    <!-- Sadistic -->

    <TraitDef>
        <defName>SWCPTrait_Sadistic</defName>
        <commonality>0.1</commonality>
        <degreeDatas>
            <li>
                <label>sadistic</label>
                <description>[PAWN_nameDef] takes genuine pleasure in inflicting pain on others. Hurting someone — in combat or otherwise — gives [PAWN_objective] a dark satisfaction.</description>
				<skillGains>
					<Melee>4</Melee>
				</skillGains>
				
				<statOffsets>
					<SWCPStat_TraitRatings_SumOfGoodBad>1</SWCPStat_TraitRatings_SumOfGoodBad>
					<SWCPStat_TraitRatings_Good>1</SWCPStat_TraitRatings_Good>
					<SWCPStat_TraitRatings_DarkSideAffinity>0.1</SWCPStat_TraitRatings_DarkSideAffinity>
				</statOffsets>
            </li>
        </degreeDatas>
		
        <!-- <conflictingTraits> -->
            <!-- <li>Kind</li> -->
        <!-- </conflictingTraits> -->
        <modExtensions>
            <li Class="SWCP.TraitExtension_InjuryMoodBoost">
                <thought>SWCPThought_SadisticBrute</thought>
                <minDamage>1</minDamage>
            </li>
        </modExtensions>
    </TraitDef>
	<ThoughtDef>
        <defName>SWCPThought_SadisticBrute</defName>
        <thoughtClass>Thought_Memory</thoughtClass>
        <durationDays>0.3</durationDays>
        <stackLimit>3</stackLimit>
        <stackedEffectMultiplier>0.5</stackedEffectMultiplier>
        <stages>
            <li>
                <label>drew blood</label>
                <description>I hurt someone recently. It felt good.</description>
                <baseMoodEffect>8</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>
	
	
	
	
	
	<!-- Loyal -->
	
	<TraitDef>
		<defName>SWCPTrait_Loyal</defName>
		<commonality>0.6</commonality>
		<degreeDatas>
			<li>
				<label>loyal</label>
				<description>[PAWN_nameDef] is fiercely dedicated to [PAWN_possessive] faction and [PAWN_possessive] friends, and will never willingly abandon them.</description>
				<degree>0</degree>
				<disallowedMentalStates>
                    <li>GiveUpExit</li>
                </disallowedMentalStates>
				<statFactors>
					<SWCPStat_Loyalty>2</SWCPStat_Loyalty>
				</statFactors>
				
				<statOffsets>
					<SWCPStat_Willpower>0.25</SWCPStat_Willpower>
					
					<SWCPStat_TraitRatings_SumOfGoodBad>1</SWCPStat_TraitRatings_SumOfGoodBad>
					<SWCPStat_TraitRatings_Good>1</SWCPStat_TraitRatings_Good>
					<SWCPStat_TraitRatings_LightSideAffinity>0.1</SWCPStat_TraitRatings_LightSideAffinity>
				</statOffsets>
			</li>
		</degreeDatas>
		<conflictingTraits>
            <li>SWCPTrait_Unyielding</li>
            <li>SWCPTrait_Cowardly</li>
        </conflictingTraits>
	</TraitDef>
	
	
	
	
	
	
	
	
	<!-- Cowardly -->
	
	<TraitDef>
		<defName>SWCPTrait_Cowardly</defName>
		<commonality>0.3</commonality>
		<degreeDatas>
			<li>
				<label>cowardly</label>
				<description>When the going gets tough, [PAWN_nameDef] is the first to falter and run for [PAWN_possessive] life. [PAWN_nameDef] will try to abandon [PAWN_possessive] faction or colony if [PAWN_pronoun] is sufficiently injured while drafted or upset.</description>
				<degree>0</degree>
				<socialFightChanceFactor>0</socialFightChanceFactor>
				<statFactors>
					<SWCPStat_Willpower>0.5</SWCPStat_Willpower>
				</statFactors>
				<theOnlyAllowedMentalBreaks>
					<li>Wander_OwnRoom</li>
					<li>GiveUpExit</li>
                    <!-- <li>PanicFlee</li> these are not MentalBreakDefs -->
                    <!-- <li>PanicFleeFire</li> -->
				</theOnlyAllowedMentalBreaks>
				
				<statOffsets>
					<SWCPStat_Loyalty>-0.5</SWCPStat_Loyalty>
					
					<SWCPStat_TraitRatings_SumOfGoodBad>-1</SWCPStat_TraitRatings_SumOfGoodBad>
					<SWCPStat_TraitRatings_Bad>1</SWCPStat_TraitRatings_Bad>
					<SWCPStat_TraitRatings_DarkSideAffinity>0.1</SWCPStat_TraitRatings_DarkSideAffinity>
				</statOffsets>
			</li>
		</degreeDatas>
		<conflictingTraits>
            <li>SWCPTrait_Unyielding</li>
            <li>SWCPTrait_Loyal</li>
        </conflictingTraits>
		<modExtensions>
			<li Class="SWCP.TraitExtension_DraftedHediff">
				<hediff>SWCPTraitHediff_Cowardly</hediff>
			</li>
		</modExtensions>
	</TraitDef>
	<HediffDef>
		<defName>SWCPTraitHediff_Cowardly</defName>
		<label>Cowardly</label>
		<description>This is a hidden hediff that is only active while this pawn is drafted. This pawn will have an increasing % chance to panic flee or hide in their room if more than 20 points of damage is taken.</description>
		<hediffClass>HediffWithComps</hediffClass>
		<defaultLabelColor>(255,7,48)</defaultLabelColor> <!-- red -->
		<isBad>false</isBad>
		<initialSeverity>1</initialSeverity>
		<stages>
			<li><minSeverity>0.01</minSeverity><becomeVisible>false</becomeVisible></li>
			
			<li><!-- remember, you're starting at severity 1 -->
				<label>20 damage</label>
				<minSeverity>3</minSeverity>
				<becomeVisible>false</becomeVisible>
				<statOffsets>
					<!-- <PainShockThreshold>-0.2</PainShockThreshold> -->
					<MentalBreakThreshold>1</MentalBreakThreshold>
				</statOffsets>
				<mentalStateGivers>
					<li><mentalState>GiveUpExit</mentalState><mtbDays>2</mtbDays></li>
					<li><mentalState>PanicFlee</mentalState><mtbDays>1.5</mtbDays></li>
					<li><mentalState>Wander_OwnRoom</mentalState><mtbDays>0.75</mtbDays></li>
				</mentalStateGivers>
			</li>
			<li>
				<label>30 damage</label>
				<minSeverity>4</minSeverity>
				<becomeVisible>false</becomeVisible>
				<statOffsets>
					<MentalBreakThreshold>10</MentalBreakThreshold>
				</statOffsets>
				<mentalStateGivers>
					<li><mentalState>GiveUpExit</mentalState><mtbDays>1</mtbDays></li>
					<li><mentalState>PanicFlee</mentalState><mtbDays>0.75</mtbDays></li>
					<li><mentalState>Wander_OwnRoom</mentalState><mtbDays>0.25</mtbDays></li>
				</mentalStateGivers>
			</li>
			<li>
				<label>40 damage</label>
				<minSeverity>5</minSeverity>
				<becomeVisible>false</becomeVisible>
				<statOffsets>
					<MentalBreakThreshold>100</MentalBreakThreshold>
				</statOffsets>
				<mentalStateGivers>
					<li><mentalState>GiveUpExit</mentalState><mtbDays>0.75</mtbDays></li>
					<li><mentalState>PanicFlee</mentalState><mtbDays>0.5</mtbDays></li>
					<li><mentalState>Wander_OwnRoom</mentalState><mtbDays>0.1</mtbDays></li>
				</mentalStateGivers>
			</li>
			
		</stages>
		
		<comps>
            <li Class="EBSGFramework.HediffCompProperties_SeverityByMap">
				<notInMap>0</notInMap> <!-- Severity to use when the pawn isn't being held in a map (usually due to being in a caravan, shuttle, or other type of transportation -->
            </li>
			<li Class="EBSGFramework.HediffCompProperties_SeverityChangeWhenDamaged">
                <severityChangeFactor>0.1</severityChangeFactor> <!-- For example, if set to 0.01, a damage of 10 increases severity by 0.1 -->
            </li>
        </comps>
	</HediffDef>
	
	
	
	
	
	
	
	
	
	<!-- Charismatic: others form a warmer opinion of the pawn who has this trait. -->
	
	<TraitDef>
		<defName>SWCPTrait_Charismatic</defName>
		<commonality>1.5</commonality>
		<degreeDatas>
			<li>
				<label>charismatic</label>
				<description>[PAWN_nameDef] has an easy, magnetic presence that others warm to quickly.</description>
				<degree>0</degree>
				<statOffsets>
					<SocialImpact>0.20</SocialImpact>
					
					<SWCPStat_TraitRatings_SumOfGoodBad>1</SWCPStat_TraitRatings_SumOfGoodBad>
					<SWCPStat_TraitRatings_Good>1</SWCPStat_TraitRatings_Good>
				</statOffsets>
			</li>
		</degreeDatas>
	</TraitDef>
	
	
	<ThoughtDef>
		<defName>SWCPThought_CharismaticReaction</defName>
		<thoughtClass>Thought_SituationalSocial</thoughtClass>
		<workerClass>SWCP_FlyingSloth_Misc.ThoughtWorker_TraitOpinion</workerClass>
		<modExtensions>
		  <li Class="SWCP_FlyingSloth_Misc.ThoughtExtension_TraitOpinion">
			<requiredTrait>SWCPTrait_Charismatic</requiredTrait>
			<source>Target</source>
		  </li>
		</modExtensions>
		<stages>
		  <li>
			<label>charismatic</label>
			<baseOpinionOffset>15</baseOpinionOffset>
		  </li>
		</stages>
	</ThoughtDef>







	<!-- Arrogant: the arrogant pawn forms a worse opinion of everyone else. -->

	<TraitDef>
		<defName>SWCPTrait_Arrogant</defName>
		<commonality>1.75</commonality>
		<degreeDatas>
			<li>
				<label>arrogant</label>
				<description>[PAWN_nameDef] looks down on nearly everyone else.</description>
				<degree>0</degree>
				<statOffsets>
					<SWCPStat_TraitRatings_SumOfGoodBad>-1</SWCPStat_TraitRatings_SumOfGoodBad>
					<SWCPStat_TraitRatings_Bad>1</SWCPStat_TraitRatings_Bad>
					<SWCPStat_TraitRatings_DarkSideAffinity>0.1</SWCPStat_TraitRatings_DarkSideAffinity>
				</statOffsets>
			</li>
		</degreeDatas>
	</TraitDef>

	
	<ThoughtDef>
		<defName>SWCPThought_ArrogantReaction</defName>
		<thoughtClass>Thought_SituationalSocial</thoughtClass>
		<workerClass>SWCP_FlyingSloth_Misc.ThoughtWorker_TraitOpinion</workerClass>
		<modExtensions>
		  <li Class="SWCP_FlyingSloth_Misc.ThoughtExtension_TraitOpinion">
			<requiredTrait>SWCPTrait_Arrogant</requiredTrait>
			<source>Self</source>
		  </li>
		</modExtensions>
		<stages>
		  <li>
			<label>arrogant</label>
			<baseOpinionOffset>-12</baseOpinionOffset>
		  </li>
		</stages>
	</ThoughtDef>











	<!-- Swindler: others form a worse opinion of the pawn who has this trait. -->

	<TraitDef>
		<defName>SWCPTrait_Swindler</defName>
		<commonality>1</commonality>
		<degreeDatas>
			<li>
				<label>swindler</label>
				<description>[PAWN_nameDef] has a well-earned reputation for cheating people out of what's theirs.</description>
				<degree>0</degree>
				<statOffsets>
					<TradePriceImprovement>0.2</TradePriceImprovement>
					
					<SWCPStat_TraitRatings_SumOfGoodBad>1</SWCPStat_TraitRatings_SumOfGoodBad>
					<SWCPStat_TraitRatings_Good>1</SWCPStat_TraitRatings_Good>
					<SWCPStat_TraitRatings_DarkSideAffinity>0.1</SWCPStat_TraitRatings_DarkSideAffinity>
				</statOffsets>
			</li>
		</degreeDatas>
	</TraitDef>


	<ThoughtDef>
		<defName>SWCPThought_SwindlerReaction</defName>
		<thoughtClass>Thought_SituationalSocial</thoughtClass>
		<workerClass>SWCP_FlyingSloth_Misc.ThoughtWorker_TraitOpinion</workerClass>
		<modExtensions>
		  <li Class="SWCP_FlyingSloth_Misc.ThoughtExtension_TraitOpinion">
			<requiredTrait>SWCPTrait_Swindler</requiredTrait>
			<source>Target</source>
		  </li>
		</modExtensions>
		<stages>
		  <li>
			<label>swindler</label>
			<baseOpinionOffset>-5</baseOpinionOffset>
		  </li>
		</stages>
	</ThoughtDef>










	<!-- Healer: skilled at tending wounds, and feels good about it (mood half is in Thoughts_Healer.xml / TraitHealer.cs). -->
	<TraitDef>
		<defName>SWCP_Healer</defName> <!-- hardcoded defName from DefOf -->
		<commonality>0.5</commonality>
		<degreeDatas>
			<li>
				<label>healer</label>
				<description>[PAWN_nameDef] has a gift for tending wounds and a naturally reassuring bedside manner.</description>
				<degree>0</degree>
				<statOffsets>
					<MedicalTendQuality>0.12</MedicalTendQuality>
					
					<SWCPStat_TraitRatings_SumOfGoodBad>1</SWCPStat_TraitRatings_SumOfGoodBad>
					<SWCPStat_TraitRatings_Good>1</SWCPStat_TraitRatings_Good>
					<SWCPStat_TraitRatings_LightSideAffinity>0.1</SWCPStat_TraitRatings_LightSideAffinity>
				</statOffsets>
				<skillGains>
					<Medicine>2</Medicine>
				</skillGains>
			</li>
		</degreeDatas>
	</TraitDef>
	
	
	
	<!-- Granted to a Healer-trait pawn (via Patch_DoTend_HealerMood in HarmonyPatches.cs) when they finish tending another pawn. -->
	<ThoughtDef>
		<defName>SWCP_HealerSatisfaction</defName> <!-- hardcoded defName from DefOf -->
		<thoughtClass>Thought_Memory</thoughtClass>
		<durationDays>0.5</durationDays>
		<stackLimit>4</stackLimit>
		<stages>
		  <li>
			<label>tended someone</label>
			<description>I helped tend someone's wounds. It felt good to help.</description>
			<baseMoodEffect>3</baseMoodEffect>
		  </li>
		</stages>
	</ThoughtDef>
	
	
	
	
	
	
	
	
	
	
	
	
	
	<!-- Treacherous: may permanently defect to a raid once combat starts. Raid-defection mechanics
       live in TraitTreacherous.cs / HarmonyPatches.cs; config lives in the modExtensions block
       below. The "doesn't care when a colonist dies" half of this trait is pure XML and lives in
       Patches/Patches_Treacherous.xml (nullifyingTraits on the vanilla death-mood thoughts), not here. -->
	<TraitDef>
		<defName>SWCP_Treacherous</defName> <!-- hardcoded defName from DefOf, ALSO a patch applies this as an exclusion to several ThoughtDefs -->
		<commonality>0.05</commonality>
		<degreeDatas>
			<li>
				<label>treacherous</label>
				<description>[PAWN_nameDef] has a hidden willingness to turn on the colony if the right enemy comes calling.</description>
				<degree>0</degree>
				<statOffsets>
					<SWCPStat_TraitRatings_SumOfGoodBad>-1</SWCPStat_TraitRatings_SumOfGoodBad>
					<SWCPStat_TraitRatings_Bad>1</SWCPStat_TraitRatings_Bad>
					<SWCPStat_TraitRatings_DarkSideAffinity>0.1</SWCPStat_TraitRatings_DarkSideAffinity>
				</statOffsets>
			</li>
		</degreeDatas>
		<conflictingTraits>
            <li>SWCPTrait_Unyielding</li>
            <li>SWCPTrait_Loyal</li>
        </conflictingTraits>
		<modExtensions>
			<li Class="SWCP_FlyingSloth_Misc.TraitExtension_TreacherousDefection">
				<!-- Empty/omitted = all RaidStrategyDefs qualify. Uncomment and list specific strategies to restrict. -->
				<!--
				<qualifyingRaidStrategies>
				  <li>ImmediateAttack</li>
				  <li>Siege</li>
				</qualifyingRaidStrategies>
				-->
				
				
				<!-- Optional: an additional StatDef read off the pawn that modifies the roll. Unset/omitted
				 = no modifier, baseDefectionChance is used as-is.
				 chanceModifierMode picks HOW the stat combines with baseDefectionChance: Multiplicative
				 (default; finalChance = baseDefectionChance * statValue, stat should default ~1.0) or
				 Additive (finalChance = baseDefectionChance + statValue, stat should default ~0).
				 higherStatIncreasesChance picks the DIRECTION: true (default) = a higher stat raises the
				 chance; false = a higher stat lowers it instead (e.g. a "Loyalty" stat, where more
				 loyalty should mean less betrayal - flips Multiplicative to divide and Additive to
				 subtract). Result is always clamped to [0,1] either way. -->
				
				<chanceModifierStat>SWCPStat_Loyalty</chanceModifierStat>
				<chanceModifierMode>Multiplicative</chanceModifierMode>
				<baseDefectionChance>0.75</baseDefectionChance>
				<higherStatIncreasesChance>false</higherStatIncreasesChance>
				
				<combatCheckIntervalTicks>250</combatCheckIntervalTicks>
				<cleanupIntervalTicks>2500</cleanupIntervalTicks>
				<maxPendingTicks>60000</maxPendingTicks>
			</li>
		</modExtensions>
	</TraitDef>
	
	
	
	

</Defs>
