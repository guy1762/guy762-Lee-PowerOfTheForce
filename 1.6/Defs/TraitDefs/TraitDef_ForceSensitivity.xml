<Defs>

	
	<TraitDef Name="SWPotF_Trait_ForceSensitiveBASE" Abstract="True">
		<conflictingTraits>
			<li>PsychicSensitivity</li>
			<li>SWPotFConflictingTraitTag_ForceSensitivity</li>
