		<commonality>0.01</commonality>
		<degreeDatas>
			<li>
				<label>dull Force sensitivity</label>
				<description>[PAWN_nameDef] has a minor connection with the Force. A metaphysical, spiritual, binding, and ubiquitous power that held enormous importance for both the Jedi and Sith monastic orders.</description>
				<degree>0</degree>
				<statOffsets>
					<PsychicSensitivity>0.5</PsychicSensitivity>
					
					<SWCPStat_TraitRatings_SumOfGoodBad>1</SWCPStat_TraitRatings_SumOfGoodBad>
					<SWCPStat_TraitRatings_Good>1</SWCPStat_TraitRatings_Good>
