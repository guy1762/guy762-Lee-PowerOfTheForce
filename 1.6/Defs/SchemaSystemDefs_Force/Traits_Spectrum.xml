<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<TraitDef>
		<defName>Force_NeutralSensitivity</defName>
		<commonality>2</commonality>
		<conflictingTraits>
			<li>PsychicSensitivity</li>
		</conflictingTraits>
		<degreeDatas>
			<li>
				<label>Major Force Sensitivity</label>
				<description>[PAWN_nameDef] has a very strong connection with the Force. [PAWN_pronoun] is extremely sensitive to psychic phenomena.</description>
				<degree>2</degree>
				<statOffsets>
					<PsychicSensitivity>0.8</PsychicSensitivity>
				</statOffsets>
			</li>
			<li>
				<label>Medium Force Sensitivity</label>
				<description>[PAWN_nameDef] has a strong connection with the Force. [PAWN_pronoun] is sensitive to psychic phenomena.</description>
				<degree>1</degree>
				<statOffsets>
					<PsychicSensitivity>0.8</PsychicSensitivity>
				</statOffsets>
			</li>
			<li>
				<label>Force sensitivity</label>
				<description>[PAWN_nameDef] has a connection with the Force. A metaphysical, spiritual, binding, and ubiquitous power that held enormous importance for both the Jedi and Sith monastic orders.</description>
				<degree>0</degree>
				<statOffsets>
					<PsychicSensitivity>0.4</PsychicSensitivity>
				</statOffsets>
			</li>
			<li>
				<label>Dull Force Sensitivity</label>
				<description>[PAWN_nameDef] has a weaker connection to the Force compared to other force sensitives. [PAWN_pronoun] isn't as affected by psychic phenomena.</description>
				<degree>-1</degree>
				<statOffsets>
					<PsychicSensitivity>0.2</PsychicSensitivity>
				</statOffsets>
			</li>
		</degreeDatas>
		<modExtensions>
			<li Class="Lightsaber.ModExtension_TraitColor" MayRequire="lee.theforce.lightsaber">
				<degreeColorData>
					<li>
						<degree>-1</degree>
						<color>(0.5,0.5,0.)</color>
					</li>
					<li>
						<degree>0</degree>
						<color>(0.8,0.8,0.8)</color>
					</li>
					<li>
						<degree>1</degree>
						<color>(1,1,1)</color>
					</li>
				</degreeColorData>
			</li>
			<li Class="TheForce_Standalone.ModExtension_ForceSensitivity"></li>
		</modExtensions>
	</TraitDef>

	<TraitDef>
		<defName>Force_LightAffinity</defName>
		<commonality>0.002</commonality>
		<degreeDatas>
			<li>
				<label>Major Lightside Affinity</label>
				<description>[PAWN_nameDef] has a very strong affinity with the light side of the Force.</description>
				<degree>1</degree>
				<statOffsets>
					<Force_Lightside_Attunement>2</Force_Lightside_Attunement>
				</statOffsets>
			</li>
			<li>
				<label>Lightside Affinity</label>
				<description>[PAWN_nameDef] has a strong affinity with the light side of the Force.</description>
				<degree>0</degree>
				<statOffsets>
					<Force_Lightside_Attunement>0.4</Force_Lightside_Attunement>
				</statOffsets>
			</li>
			<li>
				<label>Minor Lightside Affinity</label>
				<description>[PAWN_nameDef] has a weak affinity with the light side of the Force.</description>
				<degree>-1</degree>
				<statOffsets>
					<Force_Lightside_Attunement>0.2</Force_Lightside_Attunement>
				</statOffsets>
			</li>
		</degreeDatas>
		<modExtensions>
			<li Class="Lightsaber.ModExtension_TraitColor" MayRequire="lee.theforce.lightsaber">
				<degreeColorData>
					<li>
						<degree>-1</degree>
						<color>(0,0,0.5)</color>
					</li>
					<li>
						<degree>0</degree>
						<color>(0,0,0.8)</color>
					</li>
					<li>
						<degree>1</degree>
						<color>(0,0,1)</color>
					</li>
				</degreeColorData>
			</li>
			<li Class="TheForce_Standalone.ModExtension_ForceSensitivity"></li>
		</modExtensions>
	</TraitDef>

	<TraitDef>
		<defName>Force_DarkAffinity</defName>
		<commonality>0.002</commonality>
		<degreeDatas>
			<li>
				<label>Major Darkside Affinity</label>
				<description>[PAWN_nameDef] has a very strong affinity with the dark side of the Force.</description>
				<degree>1</degree>
				<statOffsets>
					<Force_Darkside_Attunement>0.8</Force_Darkside_Attunement>
				</statOffsets>
			</li>
			<li>
				<label>Darkside Affinity</label>
				<description>[PAWN_nameDef] has a strong affinity with the dark side of the Force.</description>
				<degree>0</degree>
				<statOffsets>
					<Force_Darkside_Attunement>0.4</Force_Darkside_Attunement>
				</statOffsets>
			</li>
			<li>
				<label>Minor Darkside Affinity</label>
				<description>[PAWN_nameDef] has a weak affinity with the dark side of the Force.</description>
				<degree>-1</degree>
				<statOffsets>
					<Force_Darkside_Attunement>0.2</Force_Darkside_Attunement>
				</statOffsets>
			</li>
		</degreeDatas>
		<modExtensions>
			<li Class="Lightsaber.ModExtension_TraitColor" MayRequire="lee.theforce.lightsaber">
				<degreeColorData>
					<li>
						<degree>-1</degree>
						<color>(0.5,0,0)</color>
					</li>
					<li>
						<degree>0</degree>
						<color>(0.8,0,0)</color>
					</li>
					<li>
						<degree>1</degree>
						<color>(1.0,0,0)</color>
					</li>
				</degreeColorData>
			</li>
			<li Class="TheForce_Standalone.ModExtension_ForceSensitivity"></li>
		</modExtensions>

	</TraitDef>


</Defs>
