<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<HediffDef ParentName="ProgressTrackerHediffBase"> 
		<defName>SWPotF_Hediff_HeroModeProgression</defName>
		<hediffClass>ItsSorceryFramework.Hediff_ProgressLevel</hediffClass>
		<label>Heroic</label>
		<defaultLabelColor>(215,195,90)</defaultLabelColor> <!-- skywalker yellow -->
		<description>Hero level progression.</description>
		<initialSeverity>1</initialSeverity> <!-- Severity is bound to level of implant -->
		<minSeverity>0</minSeverity>
		<countsAsAddedPartOrImplant>false</countsAsAddedPartOrImplant>
		<stages>	
		</stages>
	</HediffDef>
	
	
	
	<ItsSorceryFramework.ProgressTrackerDef ParentName = "ProgressTrackerLevelBase">
		<defName>SWPotF_ProgressTracker_HeroModeLvl</defName>
		<label>Heroic</label>
		<progressTrackerClass>ItsSorceryFramework.ProgressTracker_Level</progressTrackerClass>
		<bgPath>UI/ForceSchemaBackground</bgPath>
		
		<progressLevelUpKey>SWPotF_HeroMode_LevelUp</progressLevelUpKey>
		<progressLevelUpDescKey>SWPotF_HeroMode_LevelUpMessage</progressLevelUpDescKey>
		<skillPointLabelKey>SWPotF_HeroMode_SkillPointLabel</skillPointLabelKey>
		
		<progressHediff>SWPotF_Hediff_HeroModeProgression</progressHediff>
		<baseClass>SWPotFClassProgressTracker_Heroic_levelone</baseClass> <!-- linking a base class is required -->


		<baseEXP>100</baseEXP> <!-- default: 100 -->
		<scaling>1.1</scaling> <!-- default: 1.1 | Used to set up the experience required for each level. See equationType for how it is used. -->
	</ItsSorceryFramework.ProgressTrackerDef>
	
	
	
	
	
	
	
	<ItsSorceryFramework.ProgressTrackerClassDef Abstract = "True" Name = "SWPotF_ProgressTrackerClass_base_HeroModeLvl" ParentName = "ProgressTrackerClassBase">
		<progressTrackerDef>SWPotF_ProgressTracker_HeroModeLvl</progressTrackerDef>
		
		<expTags>
			<li>SWPotF_HeroEXPTag_OnQuestWin</li>
			<li>SWPotF_HeroEXPTag_OddityXP</li>
			<!-- <li>SWPotF_ForceEXPTag_OnSkillEXP</li> -->
		</expTags>
	</ItsSorceryFramework.ProgressTrackerClassDef>	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	
	<ItsSorceryFramework.ProgressEXPTagDef ParentName = "EXPTag_OnQuestFinish">
		<workerClass>ItsSorceryFramework.ProgressEXPWorker_OnQuestFinish</workerClass>
		<defName>SWPotF_HeroEXPTag_OnQuestWin</defName>
		<fixedEXP>10</fixedEXP>
		<questOutcome>Success</questOutcome>
		<questDefs/>
	</ItsSorceryFramework.ProgressEXPTagDef>
	
	<ItsSorceryFramework.ProgressEXPTagDef ParentName = "EXPTag_Passive">
		<workerClass>ItsSorceryFramework.ProgressEXPWorker_Passive</workerClass>
		<defName>SWPotF_HeroEXPTag_PassiveDebug</defName>
		<fixedEXP>2</fixedEXP> <!-- is divided by two for some reason -->
	</ItsSorceryFramework.ProgressEXPTagDef>
	
	
	<!--
	
	NEEDS:
	
	ProgressEXPWorker_OnHonorGain - gives XP for gaining any Royalty DLC Honor regardless of faction. should have an option for X amount of XP per point of Honor
	
	ProgressEXPWorker_OnTitleGain - XP for gaining any Royalty title. X amount of XP per new title
	
	
	-->

	
	
	
	
	
	
	
	<ItsSorceryFramework.ProgressTrackerClassDef ParentName = "SWPotF_ProgressTrackerClass_base_HeroModeLvl">
		<defName>SWPotFClassProgressTracker_Heroic_levelone</defName>
		<label>Heroic (classless)</label>
		<description>Please wait a moment for the class selections to unlock themselves via level up.</description>
		
		<levelRange>1~2</levelRange>
		<levelLabels>
			<li><level>1</level><label>loading, please wait</label></li>
			<li><level>2</level><label>classless</label></li>
		</levelLabels>
		
		<linkedClasses>
			<li>
				<classDef>SWPotFClassProgressTracker_Heroic_goon</classDef>
				<levelReset>True</levelReset>
				<benefitReset>False</benefitReset>
				<removePostClassChange>True</removePostClassChange>
			</li>
			<li>
				<classDef>SWPotFClassProgressTracker_Heroic_socialite</classDef>
				<levelReset>True</levelReset>
				<benefitReset>False</benefitReset>
				<removePostClassChange>True</removePostClassChange>
			</li>
		</linkedClasses>
		<levelSpecifics>
			<li>
				<level>2</level>
				<!-- <pointGain>0</pointGain> important to remember: this is 1 by default -->
				<pointGain>2</pointGain>
				
				<specialClasses>
					<li>
						<classDef>SWPotFClassProgressTracker_Heroic_goon</classDef>
						<levelReset>True</levelReset>
						<benefitReset>False</benefitReset>
						<removePostClassChange>True</removePostClassChange>
					</li>
					<li>
						<classDef>SWPotFClassProgressTracker_Heroic_socialite</classDef>
						<levelReset>True</levelReset>
						<benefitReset>False</benefitReset>
						<removePostClassChange>True</removePostClassChange>
					</li>
				</specialClasses>
			</li>
		</levelSpecifics>

		
		<expTags>
			<li>SWPotF_HeroEXPTag_PassiveDebug</li>
		</expTags>
	</ItsSorceryFramework.ProgressTrackerClassDef>
	
	
	
	
	
	
	
